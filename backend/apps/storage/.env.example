PORT=8002
NODE_ENV=development

# Database
DATABASE_URL=postgresql://localhost:5432

# gRPC
PROTOC_PATH=protoc
AUTH_GRPC_URL=0.0.0.0:8001
STORAGE_GRPC_URL=0.0.0.0:8002

# redis (event bus)
REDIS_URL=redis://localhost:6379
# 0 = dual stack, 4 = IPv4 only, 6 = IPv6 only. Keep 0 on IPv6-only private networks (Railway).
# REDIS_IP_FAMILY=0
# Everything below is optional — the values shown are the defaults @backend/redis falls back to.
# BullMQ key prefix and the namespace of the bus' own keys (subscription sets, parking lists).
# Override both to run a second stack against one Redis without the two seeing each other.
# REDIS_QUEUE_PREFIX=bull
# REDIS_EVENT_BUS_NAMESPACE=event-bus
# Jobs one worker handles at once. 1 keeps delivery within a queue ordered.
# REDIS_WORKER_CONCURRENCY=1
# Redelivery ladder before a job lands in the `failed` set (the DLQ): exponential backoff from
# REDIS_JOB_BACKOFF_DELAY ms.
# REDIS_JOB_ATTEMPTS=10
# REDIS_JOB_BACKOFF_DELAY=1000
# Events emitted before anyone had subscribed are parked here and replayed on a consumer's
# first-ever registration. Length 0 disables parking, TTL is in seconds.
# REDIS_PARKING_MAX_LENGTH=1000
# REDIS_PARKING_TTL=86400

# bunny
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_CDN_ZONE=
BUNNY_STORAGE_CDN_PRIVATE_KEY=
BUNNY_STORAGE_CDN_EXPIRES_IN_MINUTES=10
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_ZONE=
BUNNY_STREAM_CDN_PRIVATE_KEY=
BUNNY_STREAM_CDN_EXPIRES_IN_MINUTES=60
