{
  "name": "@backend/common",
  "private": true,
  "author": "Yauheni Shcharbakou <iipekolict@gmail.com>",
  "license": "MIT",
  "version": "0.0.0",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "format": "prettier src --write --config ../../../.prettierrc",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "dev": "pnpm build --watch",
    "build": "tsdown",
    "test": "jest",
    "test:watch": "jest --watch",
    "reset": "rm -rf .turbo dist node_modules",
    "reset:modules": "rm -rf node_modules"
  },
  "dependencies": {
    "@backend/proto": "workspace:*",
    "@nestjs/common": "11.1.27",
    "@packages/common": "workspace:*",
    "@sweet-monads/either": "3.3.1",
    "lodash": "4.18.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/microservices": "11.1.27",
    "@packages/configs": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.23",
    "jest": "30.3.0",
    "ts-jest": "29.4.9"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
