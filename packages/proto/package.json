{
  "name": "@packages/proto",
  "private": true,
  "author": "Yauheni Shcharbakou <iipekolict@gmail.com>",
  "license": "MIT",
  "version": "0.0.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "format": "prettier src --write --config ../../.prettierrc",
    "dev": "pnpm build --watch",
    "build": "pnpm format --log-level error && tsdown",
    "compile": "tsx compiler/main.ts",
    "typecheck": "tsc --noEmit",
    "reset": "rm -rf .turbo dist node_modules",
    "reset:modules": "rm -rf node_modules"
  },
  "devDependencies": {
    "@grpc/grpc-js": "catalog:",
    "@packages/compiler-utils": "workspace:*",
    "@packages/configs": "workspace:*",
    "@types/pug": "catalog:",
    "change-case-all": "catalog:",
    "prettier": "catalog:",
    "protobufjs": "catalog:",
    "pug": "catalog:",
    "ts-morph": "catalog:",
    "ts-proto": "2.11.6",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
