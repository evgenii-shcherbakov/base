{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "10",
  "envMode": "loose",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^compile", "^build", "compile"]
    },
    "compile": {
      "dependsOn": ["^compile", "^build"]
    },
    "prod": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      // Whether the suite runs or skips depends on a broker being reachable, which is not an
      // input turbo can hash — a cached result would replay the wrong verdict.
      "cache": false,
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "reset": {
      "cache": false
    },
    "reset:modules": {
      "cache": false
    }
  }
}
