{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "10",
  "envMode": "loose",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^compile", "^build", "compile"]
    },
    "compile": {
      "dependsOn": ["^compile", "^build"]
    },
    "prod": {},
    "test": {
      // The task is cached, so `env` has to name every variable a suite reads — envMode is
      // loose, which hashes nothing on its own, while the config modules validate env at
      // import time and the config specs assert its defaults. NODE_ENV/PORT come from
      // `NodeValidationSchema`, which every suite pulls in through @backend/common; the
      // prefixes cover the two transport packages. Keep the list here rather than in a
      // package turbo.json: a package-level task replaces this field instead of extending
      // it, so a local `env` would silently drop the entries above.
      "env": ["NODE_ENV", "PORT", "REDIS_*", "NATS_*"],
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      // Whether the suite runs or skips depends on a broker being reachable, which is not an
      // input turbo can hash — a cached result would replay the wrong verdict.
      "cache": false,
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "reset": {
      "cache": false
    },
    "reset:modules": {
      "cache": false
    }
  }
}
